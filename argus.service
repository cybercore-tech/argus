[Unit]
Description=Argus — real-time file-integrity watcher (extends SigilWard's baseline live)
Documentation=https://github.com/cybercore-tech/argus
After=local-fs.target

[Service]
Type=simple
# Root, deliberately — unlike sigilward-check.service (User=raven), which
# has been silently unable to read /etc/sudoers (mode 0440 root:root) the
# whole time it's been "watching" it. Argus needs real read access to the
# paths it's actually meant to detect tampering in.
User=root
WorkingDirectory=/home/raven/tools/security/argus
ExecStart=/home/raven/.cargo-target/release/argus daemon
Restart=on-failure
RestartSec=5

# systemd sets HOME=/root for an explicit User=root unless told otherwise —
# config.rs/baseline paths all resolve via $HOME (to match SigilWard's own
# lookup exactly), so without this the daemon would silently look for
# config at /root/.config/sigilward/config.toml and never find the real one.
Environment=HOME=/home/raven

# ReadWritePaths' target must already exist before this unit ever starts.
# First real deploy hit this twice: attempt 1 (no ExecStartPre at all) hit
# 226/NAMESPACE directly; attempt 2 tried a `+`-prefixed ExecStartPre
# mkdir, on the assumption `+` escapes sandboxing the way it escapes
# User=/CapabilityBoundingSet= — wrong. `+` only escapes privilege-related
# settings; mount namespacing (ProtectSystem/ReadWritePaths/ProtectHome)
# applies to every Exec* line in the unit regardless, so the mkdir itself
# was sandboxed against a ReadWritePaths target that didn't exist yet —
# same failure, one step earlier. There's no in-unit way to bootstrap this;
# StateDirectory= would auto-create it but only under /var/lib, not
# ~/.local/state (needed so the unprivileged `argus`/`argus events` CLI
# reads the exact same file). So: create it once, as yourself, before
# first start — plain `mkdir`, no root needed, it's under your own home:
#     mkdir -p /home/raven/.local/state/argus
# (root writes into it fine afterward via the retained CAP_DAC_OVERRIDE
# below — no chown needed either.)

# This unit deliberately does NOT try to send desktop notifications — that
# was tried two ways (exporting DBUS_SESSION_BUS_ADDRESS on root's own
# environment, then dropping to `runuser -u raven` for just that
# subprocess) and neither reliably worked: a process reaching a real user
# desktop session from a *system* unit runs into session/cgroup-scope
# problems that plain env vars don't solve. See toast.rs and
# argus-notify.service — a completely separate `--user` unit now owns
# toasts, running genuinely inside the session, no bridging needed. This
# daemon's only job is detect-and-log.

# Sandboxing. Real runtime footprint: reads the paths named in
# ~/.config/sigilward/config.toml and SigilWard's baseline.json (both
# under /home/raven, hence ProtectHome=read-only + a carved-out
# ReadWritePaths for the one directory Argus actually writes to), plus
# the root-owned /etc paths themselves. No networking, no D-Bus, no IPC
# of any kind — RestrictAddressFamilies is empty (no sockets at all).
#
# CapabilityBoundingSet explicitly RETAINS CAP_DAC_OVERRIDE/
# CAP_DAC_READ_SEARCH — an empty set (the first version of this unit) strips
# even root's own DAC-bypass power, which is the entire reason this runs as
# root in the first place (reading /etc/sudoers, mode 0440 root:root).
# Everything else root doesn't need (CAP_SYS_ADMIN, CAP_NET_ADMIN,
# CAP_SETUID, ...) is dropped — no longer needs SETUID/SETGID now that
# notifications moved to a separate unprivileged unit.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/raven/.local/state/argus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
