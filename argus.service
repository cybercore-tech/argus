[Unit]
Description=Argus — real-time file-integrity watcher (extends SigilWard's baseline live)
Documentation=https://github.com/darkstardevx/argus
After=local-fs.target

[Service]
Type=simple
# Root, deliberately — unlike sigilward-check.service (User=raven), which
# has been silently unable to read /etc/sudoers (mode 0440 root:root) the
# whole time it's been "watching" it. Argus needs real read access to the
# paths it's actually meant to detect tampering in.
User=root
WorkingDirectory=/home/raven/tools/security/argus
ExecStart=/home/raven/.cargo-target/release/argus daemon
Restart=on-failure
RestartSec=5

# systemd sets HOME=/root for an explicit User=root unless told otherwise —
# config.rs/baseline paths all resolve via $HOME (to match SigilWard's own
# lookup exactly), so without this the daemon would silently look for
# config at /root/.config/sigilward/config.toml and never find the real one.
Environment=HOME=/home/raven

# ReadWritePaths' target must already exist before the sandboxed namespace
# is set up — unlike StateDirectory=, it is NOT auto-created, and the first
# real deploy hit exactly that (226/NAMESPACE: "No such file or directory").
# `+` runs these two outside the sandbox (full privileges, ignores User=/
# ProtectSystem/etc.) specifically so they can create+chown it before the
# real ExecStart's namespace is set up — idempotent, no manual step needed.
ExecStartPre=+/usr/bin/mkdir -p /home/raven/.local/state/argus
ExecStartPre=+/usr/bin/chown raven:raven /home/raven/.local/state/argus

# A root service has no user session by default — point it at raven's own
# D-Bus/Wayland sockets so `omarchy-notification-send` (toast.rs) can
# actually reach the desktop. /run/user/1000/bus is world-read/writable
# (srw-rw-rw-) and root can connect to any unix socket regardless of its
# owner, so this should work, but it's the one part of this unit I
# couldn't verify myself (no passwordless sudo in this sandbox) — check
# it fires a real toast after enabling the unit; if not, this is the
# first thing to debug.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=WAYLAND_DISPLAY=wayland-1

# Sandboxing. Real runtime footprint: reads the paths named in
# ~/.config/sigilward/config.toml and SigilWard's baseline.json (both
# under /home/raven, hence ProtectHome=read-only + a carved-out
# ReadWritePaths for the one directory Argus actually writes to), plus
# the root-owned /etc paths themselves, and shells out to
# omarchy-notification-send for desktop toasts.
#
# CapabilityBoundingSet explicitly RETAINS CAP_DAC_OVERRIDE/
# CAP_DAC_READ_SEARCH — an empty set (the first version of this unit) strips
# even root's own DAC-bypass power, which is the entire reason this runs as
# root in the first place (reading /etc/sudoers, mode 0440 root:root).
# Everything else root doesn't need (CAP_SYS_ADMIN, CAP_NET_ADMIN,
# CAP_SETUID, ...) is still dropped.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/raven/.local/state/argus
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
